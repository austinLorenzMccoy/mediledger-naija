# MediLedger Nigeria — Frontend Environment Variables
# Copy this file to .env.local and fill in all values before running `npm run dev`
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser bundle.

# ── Supabase (self-hosted on AWS af-south-1) ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=<generated-via-supabase-cli>

# ── NestJS API Gateway (proxied by Next.js rewrites in next.config.mjs) ─────
# In Docker: http://api-gateway:3000  |  Local dev: http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# ── Python AI Service (only needed if bypassing the gateway directly) ────────
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:3008

# ── Hedera Hashgraph ─────────────────────────────────────────────────────────
# testnet | mainnet
NEXT_PUBLIC_HEDERA_NETWORK=testnet

# HEAL fungible token ID (created by scripts/create-heal-token.js)
NEXT_PUBLIC_HEAL_TOKEN_ID=0.0.XXXXXX

# ── Wallet mode ──────────────────────────────────────────────────────────────
# "mock"  → use mock wallet (no browser extension required) — for demos / CI
# "live"  → use real HashPack / Blade / WalletConnect  — for production
NEXT_PUBLIC_WALLET_MODE=mock

# ── WalletConnect (required when WALLET_MODE=live) ───────────────────────────
# Obtain from https://cloud.walletconnect.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=<walletconnect-project-id>

# ── Vercel Analytics (optional) ──────────────────────────────────────────────
# Set automatically by Vercel — leave blank for local dev
NEXT_PUBLIC_VERCEL_ANALYTICS_ID=
