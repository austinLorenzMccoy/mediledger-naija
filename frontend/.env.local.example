# MediLedger Nigeria — Frontend Environment Variables
# For Vercel: use frontend/.env (import in Project Settings → Environment Variables)
# For local:  cp .env.local.example .env.local  then fill values
#
# Only NEXT_PUBLIC_* — never put service_role or private keys in the frontend.

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# ── API (optional until NestJS is deployed) ─────────────────────────────────
# Local: http://localhost:3000  |  Production: https://your-api-host
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_AI_SERVICE_URL=http://localhost:3008

# ── Hedera ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_HEDERA_NETWORK=testnet
NEXT_PUBLIC_HEAL_TOKEN_ID=0.0.XXXXXX

# ── Wallet ──────────────────────────────────────────────────────────────────
# live = HashPack/Blade (use on Vercel). mock = local demo only.
NEXT_PUBLIC_WALLET_MODE=live
NEXT_PUBLIC_ALLOW_MOCK_WALLET=false
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001
